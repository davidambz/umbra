#pragma once

// Generated by CMake (configure_file, see CMakeLists.txt's UMBRA_VERSION
// block) into <build>/generated/version.h — not checked into the repo.
// Consumed by resources/umbra.rc's VERSIONINFO block, so umbra.exe carries
// real version metadata (Explorer > Properties > Details) instead of
// nothing at all.

#define UMBRA_VERSION_MAJOR @UMBRA_VERSION_MAJOR@
#define UMBRA_VERSION_MINOR @UMBRA_VERSION_MINOR@
#define UMBRA_VERSION_PATCH @UMBRA_VERSION_PATCH@
#define UMBRA_VERSION_STRING "@UMBRA_VERSION@"
