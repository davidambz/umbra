#include <winver.h>

#include "resource.h"
#include "version.h"

// umbra.exe's own icon — shown in Explorer, the taskbar, Alt-Tab, and
// (loaded by id at runtime in main.cpp) the tray icon, so both stay the
// same violet mark instead of the tray defaulting to a generic
// IDI_APPLICATION icon.
IDI_APP_ICON ICON "app.ico"

// File version metadata — shown in Explorer > right-click umbra.exe >
// Properties > Details. UMBRA_VERSION_MAJOR/MINOR/PATCH/_STRING come from
// version.h, generated by CMake from UMBRA_VERSION (see CMakeLists.txt) —
// per #37, that's either an explicit -DUMBRA_VERSION=X.Y.Z (a release
// build) or whatever `git describe` finds locally, so this never needs
// hand-editing per release.
VS_VERSION_INFO VERSIONINFO
    FILEVERSION     UMBRA_VERSION_MAJOR,UMBRA_VERSION_MINOR,UMBRA_VERSION_PATCH,0
    PRODUCTVERSION  UMBRA_VERSION_MAJOR,UMBRA_VERSION_MINOR,UMBRA_VERSION_PATCH,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0x0L
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "David Ambrozio"
            VALUE "FileDescription",  "Umbra"
            VALUE "FileVersion",      UMBRA_VERSION_STRING
            VALUE "InternalName",     "umbra"
            VALUE "LegalCopyright",   "Copyright (C) 2026 David Ambrozio"
            VALUE "OriginalFilename", "umbra.exe"
            VALUE "ProductName",      "Umbra"
            VALUE "ProductVersion",   UMBRA_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // U.S. English, Unicode (0x04B0 = 1200) code page.
        VALUE "Translation", 0x0409, 0x04B0
    END
END
